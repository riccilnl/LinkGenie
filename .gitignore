# 这是公开仓库专用的 .gitignore
# 使用方法：同步到公开仓库时，用这个文件替换 .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
.pytest_cache/
.venv/

# 环境变量
.env

# 数据库
data/
*.db
*.db-journal
*.db-backup*
*.db-shm
*.db-wal

# 日志
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo

# 临时文件
*.tmp
*.bak
*~

# 编译文件
*.exe
*.o
*.a
*.bat

# Go
go.work

# macOS
.DS_Store

# Deployment
deploy.sh
mcp/claude_desktop_config.json

# 文档需要进入版本控制，保留 docs-first 工作流

# 测试代码
Test/
tests/
internal/
**/*_test.go

# 同步脚本（避免泄露私有仓库信息）
scripts/sync-to-public.sh

# Windows
Thumbs.db
